{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eaglercraft",
  "main": "src/game-worker.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/GAMES", "/GAMES/*"],
    "not_found_handling": "none"
  }
}
